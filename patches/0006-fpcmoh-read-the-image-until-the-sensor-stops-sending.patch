+/* ---------------------------------------------------------------------------
+ * patches/0006: read the image until the sensor stops sending.
+ *
+ * fpc_ssm_img_read_cb() consumes exactly one record per SSM state, and both
+ * state machines provide exactly eleven read states (FP_*_WAIT4IMG_SEQ1..SEQ11).
+ * The driver therefore always reads eleven records and then stops, whatever the
+ * sensor still has queued. On the 10a5:a900 there are three more per capture --
+ * measured from usbmon, immediately after the eleventh record ends on its short
+ * packet:
+ *
+ *     993 bytes   evt cmdid 5
+ *      81 bytes   evt cmdid 5
+ *      12 bytes   evt cmdid 6
+ *
+ * Two separate things go wrong when they are left unread.
+ *
+ * First, the sensor's control handler does not service endpoint 0 while an IN
+ * transfer is outstanding, so the next control command times out no matter what
+ * it is. 0x02 (arm), 0x03 (abort) and 0x0A (dead pixel) were each observed
+ * hanging, 109 us after the last image packet; the same 0x02 completes in
+ * 12.7 ms when no capture has happened. ~1.08 s later the firmware watchdog
+ * resets the sensor, which drops off the bus and re-enumerates at a new address
+ * (measured at +1.073 s and +1.076 s from the last image packet, and it happens
+ * whether or not the host sends anything -- a run that waited 3 s in silence
+ * found the device already gone, ENODEV rather than a timeout).
+ *
+ * Second, these are TLS records. They must be handed to the enclave, not merely
+ * drained: skipping them desynchronises the TLS sequence numbering, every
+ * subsequent decrypt fails, and fpc_tee_end_enroll() returns -1 with a 92-byte
+ * template that matches nothing. Draining and discarding produces an enrollment
+ * that completes all eleven stages and then never verifies.
+ *
+ * So this reads and processes trailing records exactly as fpc_ssm_img_read_cb()
+ * does, looping until a read times out. Reads with data waiting complete in
+ * ~100 us, so the cost in the normal case is one timeout per capture.
+ *
+ * Enabled per device from fpc_dev_probe(): on a sensor that really does send
+ * exactly eleven records this would add that timeout for nothing.
+ */
+#define FPC_REM_MAX_READS (512)
+#define FPC_REM_TIMEOUT (200)
+
+static void
+fpc_read_remaining_cb (FpiUsbTransfer *transfer,
+                       FpDevice       *device,
+                       gpointer        user_data,
+                       GError         *error)
+{
+  FpiDeviceFpcMoh *self = FPI_DEVICE_FPCMOH (device);
+
+  g_return_if_fail (transfer->ssm);
+
+  if (error)
+    {
+      /* A timeout between records is how this is meant to end. */
+      if (self->rem_expect_len == 0)
+        {
+          fp_dbg ("%s: sensor has nothing further to send (%s)",
+                  G_STRFUNC, error->message);
+          g_clear_error (&error);
+          fpi_ssm_next_state (transfer->ssm);
+          return;
+        }
+
+      fp_err ("%s: sensor stopped %u bytes into a %u byte record",
+              G_STRFUNC, self->rem_received_len, self->rem_expect_len);
+      fpi_ssm_mark_failed (transfer->ssm, error);
+      return;
+    }
+
+  if (self->rem_expect_len == 0)
+    {
+      evt_hdr_t *evt = (evt_hdr_t *) transfer->buffer;
+
+      if (transfer->actual_length < sizeof (evt_hdr_t))
+        {
+          fp_err ("%s: %" G_GSIZE_FORMAT " byte runt where a record header was expected",
+                  G_STRFUNC, (gsize) transfer->actual_length);
+          fpi_ssm_mark_failed (transfer->ssm,
+                               fpi_device_error_new (FP_DEVICE_ERROR_PROTO));
+          return;
+        }
+
+      self->rem_expect_len = GUINT32_FROM_BE (evt->length);
+      self->rem_received_len = transfer->actual_length;
+
+      fp_dbg ("%s: trailing record, evtid %u, len %u", G_STRFUNC,
+              GUINT32_FROM_BE (evt->cmdid), self->rem_expect_len);
+
+      fpc_tls_buff_clear ();
+      if (transfer->actual_length > sizeof (evt_hdr_t))
+        fpc_tls_buff_put (transfer->buffer + sizeof (evt_hdr_t),
+                          transfer->actual_length - sizeof (evt_hdr_t));
+    }
+  else
+    {
+      fpc_tls_buff_put (transfer->buffer, transfer->actual_length);
+      self->rem_received_len += transfer->actual_length;
+    }
+
+  if (self->rem_received_len >= self->rem_expect_len)
+    {
+      fpc_enclave_process_data (self->dev_ctx->enclave);
+      self->rem_expect_len = 0;
+      self->rem_received_len = 0;
+    }
+
+  fpi_ssm_jump_to_state (transfer->ssm, fpi_ssm_get_cur_state (transfer->ssm));
+}
+
+/* Returns FALSE when there is nothing left to do and the SSM should advance. */
+static gboolean
+fpc_read_remaining_step (FpiSsm *ssm, FpDevice *device)
+{
+  FpiDeviceFpcMoh *self = FPI_DEVICE_FPCMOH (device);
+  FpiUsbTransfer *transfer = NULL;
+
+  if (!self->read_remaining)
+    return FALSE;
+
+  if (self->rem_reads++ >= FPC_REM_MAX_READS)
+    {
+      fp_warn ("%s: giving up after %u reads", G_STRFUNC, FPC_REM_MAX_READS);
+      return FALSE;
+    }
+
+  transfer = fpi_usb_transfer_new (device);
+  transfer->ssm = ssm;
+  fpi_usb_transfer_fill_bulk (transfer, EP_IN, EP_IN_MAX_BUF_SIZE);
+  fpi_usb_transfer_submit (transfer, FPC_REM_TIMEOUT, NULL,
+                           fpc_read_remaining_cb, NULL);
+  return TRUE;
+}
+
+static void
+fpc_read_remaining_reset (FpiDeviceFpcMoh *self)
+{
+  self->rem_expect_len = 0;
+  self->rem_received_len = 0;
+  self->rem_reads = 0;
+}
+
 static void fpc_init_sm_run_state (FpiSsm   *ssm,
                                    FpDevice *device);
 
