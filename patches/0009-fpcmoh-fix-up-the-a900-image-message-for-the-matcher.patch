--- a/libfprint/drivers/fpcmoh/fpc.c
+++ b/libfprint/drivers/fpcmoh/fpc.c
@@ -19,9 +19,173 @@
 #include "drivers_api.h"
 #include "fpc.h"
 #include <byteswap.h>
+#include <dlfcn.h>
 
 G_DEFINE_TYPE (FpiDeviceFpcMoh, fpi_device_fpcmoh, FP_TYPE_DEVICE);
 
+/* ---------------------------------------------------------------------------
+ * patches/0009: the a900's image message has a 24 byte prefix, libfpcbep.so
+ * expects 34.
+ *
+ * fpc_enclave_process_data() reassembles one application message out of however
+ * many TLS records it takes, in file-static state inside the blob, and only when
+ * the message is complete does it hand the pixels to the algorithm:
+ *
+ *     if (recv_len == 0)                          // first record of a message
+ *       {
+ *         n     = mbedtls_ssl_read (ssl, buf, 0x800);
+ *         type  = be32 (buf + 0);                 // 8 = FPC_EVT_IMG
+ *         total = be32 (buf + 4);                 // whole message, header included
+ *         dst   = (type == 8) ? msgbuf : deadpixbuf;
+ *         memcpy (dst, buf, n); recv_len = n;
+ *       }
+ *     else
+ *       recv_len += mbedtls_ssl_read (ssl, dst + recv_len, total - recv_len);
+ *
+ *     if (recv_len < total) return 0;
+ *     if (recv_len > total) return -6;
+ *
+ *     img_len = recv_len - 0xa - 0x18;             // 34 byte prefix, hardcoded
+ *     if (img_len != fpc_bep_image_get_size (img))
+ *       return -1;
+ *     ... metadata from msgbuf + 0x0c .. 0x15 ...
+ *     memcpy (pixels, msgbuf + 0x22, img_size);    // pixel source +34, hardcoded
+ *
+ * The a900 declares total = 11288 for a 64 x 176 sensor, so 11288 - 11264 = 24
+ * bytes of prefix: the twelve byte event header, ten bytes of metadata at
+ * 0x0c..0x15, and two more. The blob wants twelve more there, computes
+ * 11288 - 34 = 11254, compares it against 11264 and returns -1 -- so the
+ * algorithm never sees the image at all, every sample comes back
+ * IMAGE_LOW_QUALITY and "remaining" never moves. Ten bytes.
+ *
+ * The message is TLS between the sensor's firmware and the blob's own mbedtls,
+ * so the driver cannot alter it on the wire. It can move it afterwards: once the
+ * first record has landed, open a ten byte gap between the metadata and the
+ * pixels and tell the blob the message is ten bytes longer. Subsequent records
+ * then land at the right offsets on their own, because the blob appends at
+ * dst + recv_len. The result is the layout the blob was built for -- metadata
+ * still at 0x0c..0x15, pixels at 0x22, img_len == 11264 -- with ten bytes of
+ * ignored padding in between (nothing reads 0x16..0x21).
+ *
+ * Offsets into libfpcbep.so come from its disassembly and are pinned to the
+ * build installed here, md5 f7136fd774d5208e629bbeaa4974543a. They are checked
+ * before use rather than trusted: the TLS state word must read 16, the blob's
+ * own destination pointer must be the message buffer we think it is, and the
+ * declared length must be exactly this sensor's image plus 24. If any of that
+ * does not hold this does nothing at all, and the driver behaves as it did
+ * before. Not upstreamable, and not meant to be -- reaching into another
+ * library's private state is the price of a closed matcher. The clean fixes are
+ * a blob built for this message format, or a sensor that sends the format this
+ * blob was built for.
+ */
+#define FPCBEP_OFF_MSGBUF (0x196480)      /* where a type 8 message assembles */
+#define FPCBEP_OFF_STATE (0x196100)       /* 16 once the TLS session is up */
+#define FPCBEP_OFF_RECVLEN (0x19cf44)
+#define FPCBEP_OFF_DSTPTR (0x19cf48)
+#define FPCBEP_OFF_TOTAL (0x19cf50)
+
+#define FPC_IMG_MSG_PREFIX_HAVE (24)      /* what the a900 sends */
+#define FPC_IMG_MSG_PREFIX_WANT (34)      /* 0x18 + 0xa, what the blob computes */
+#define FPC_IMG_MSG_GAP (FPC_IMG_MSG_PREFIX_WANT - FPC_IMG_MSG_PREFIX_HAVE)
+
+/* Base address of the loaded libfpcbep.so, or NULL if it cannot be found. */
+static guint8 *
+fpc_blob_base (void)
+{
+  static guint8 *base = NULL;
+  static gboolean tried = FALSE;
+
+  if (!tried)
+    {
+      void *sym = dlsym (RTLD_DEFAULT, "fpc_enclave_init");
+      Dl_info di;
+
+      tried = TRUE;
+      if (sym != NULL && dladdr (sym, &di) != 0 && di.dli_fbase != NULL)
+        {
+          base = di.dli_fbase;
+          fp_dbg ("%s: libfpcbep at %p (%s)", G_STRFUNC, base, di.dli_fname);
+        }
+      else
+        {
+          fp_warn ("%s: cannot locate libfpcbep, image relayout unavailable",
+                   G_STRFUNC);
+        }
+    }
+
+  return base;
+}
+
+/*
+ * Insert FPC_IMG_MSG_GAP bytes between the metadata and the pixels of the image
+ * message the enclave is currently assembling. Call immediately after the
+ * fpc_enclave_process_data() that consumed the message's first record, and only
+ * on a device that needs it. Does nothing unless every precondition holds.
+ */
+static void
+fpc_img_msg_relayout (FpiDeviceFpcMoh *self)
+{
+  guint8 *base = fpc_blob_base ();
+  guint8 *msgbuf;
+  guint32 state, recv_len, total, want;
+
+  if (!self->relayout_img_msg || base == NULL)
+    return;
+
+  msgbuf = base + FPCBEP_OFF_MSGBUF;
+  state = *(guint32 *) (base + FPCBEP_OFF_STATE);
+  recv_len = *(guint32 *) (base + FPCBEP_OFF_RECVLEN);
+  total = *(guint32 *) (base + FPCBEP_OFF_TOTAL);
+
+  /* Not a message the blob is assembling into the image buffer. */
+  if (state != 16 || *(guint8 **) (base + FPCBEP_OFF_DSTPTR) != msgbuf)
+    return;
+
+  /* Nothing pending, or the message was already complete and dispatched inside
+   * the call -- too late to help, and nothing here would be safe to touch. */
+  if (recv_len == 0 || recv_len >= total)
+    return;
+
+  /* Only this sensor's layout, and only once per message: after the gap is
+   * opened total no longer matches, so a second call is a no-op. */
+  want = self->dev_ctx->img_w * self->dev_ctx->img_h;
+  if (total != want + FPC_IMG_MSG_PREFIX_HAVE)
+    return;
+
+  if (recv_len <= FPC_IMG_MSG_PREFIX_HAVE)
+    return;
+
+  memmove (msgbuf + FPC_IMG_MSG_PREFIX_WANT,
+           msgbuf + FPC_IMG_MSG_PREFIX_HAVE,
+           recv_len - FPC_IMG_MSG_PREFIX_HAVE);
+  memset (msgbuf + FPC_IMG_MSG_PREFIX_HAVE, 0, FPC_IMG_MSG_GAP);
+
+  *(guint32 *) (base + FPCBEP_OFF_RECVLEN) = recv_len + FPC_IMG_MSG_GAP;
+  *(guint32 *) (base + FPCBEP_OFF_TOTAL) = total + FPC_IMG_MSG_GAP;
+
+  fp_dbg ("%s: image message %u bytes for a %u byte image, opened a %u byte gap "
+          "at offset %u (recv_len %u -> %u)", G_STRFUNC, total, want,
+          (guint) FPC_IMG_MSG_GAP, (guint) FPC_IMG_MSG_PREFIX_HAVE,
+          recv_len, recv_len + FPC_IMG_MSG_GAP);
+}
+
+/* fpc_enclave_process_data(), plus the relayout, plus the return value the
+ * driver used to throw away. */
+static gint32
+fpc_process_data (FpiDeviceFpcMoh *self, const char *what)
+{
+  gint32 status = fpc_enclave_process_data (self->dev_ctx->enclave);
+
+  if (status != 0)
+    fp_warn ("fpc_enclave_process_data (%s) failed: %d", what, status);
+  else
+    fp_dbg ("fpc_enclave_process_data (%s) -> 0", what);
+
+  fpc_img_msg_relayout (self);
+
+  return status;
+}
+
 typedef void (*SynCmdMsgCallback) (FpiDeviceFpcMoh *self,
                                    guint8          *resp,
                                    GError          *error);
