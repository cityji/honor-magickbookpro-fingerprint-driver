+
+/* ---------------------------------------------------------------------------
+ * EXPERIMENT (patches/0005): post-capture recovery probes for FPC 10a5:a900.
+ *
+ * The a900 stops answering endpoint 0 once an image capture has completed:
+ * the byte-identical vendor command 40 02 0001 / 0f100107 (FP_ENROLL_CAPTURE's
+ * "arm") is acknowledged in 12.7 ms before a capture and is still unanswered
+ * 1 s after one. Roughly 1.07 s after that SETUP the sensor drops its pull-up
+ * and re-enumerates. Enrollment therefore never gets past its first sample.
+ *
+ * Every knob below is OFF by default and each is selected by an environment
+ * variable, so all of them share one build and one install. Nothing here sends
+ * a bmRequestType 0x40 request the driver does not already issue elsewhere:
+ *
+ *   FPC_X_DELAY_MS           wait this long after the previous capture before
+ *                            re-arming. Also the control measurement: with a
+ *                            long enough delay and nothing in flight, usbmon
+ *                            shows whether the device disconnects on its own
+ *                            or only when a SETUP is outstanding.
+ *   FPC_X_DRAIN / _MS        do up to N bulk-IN reads with a short timeout
+ *                            before re-arming, in case the device still has a
+ *                            queued event that blocks its EP0 handler.
+ *   FPC_X_POSTDRAIN / _MS    the same, but immediately after the image loop
+ *                            rather than before the next arm. This is the only
+ *                            intervention still possible inside the window:
+ *                            measured, EP0 stops answering 109 us after the
+ *                            last image packet, so no control command can help,
+ *                            and the sensor detaches 1.08 s later.
+ *   FPC_X_POSTDELAY_MS       pause after the image before the next command, to
+ *                            see whether EP0 comes back inside that window.
+ *   FPC_X_REINIT             1 = re-send the init prologue (0x01, event read,
+ *                                0x08, 0x0b read);
+ *                            2 = full init incl. a fresh TLS handshake, but
+ *                                keeping the existing tee/bio so the samples
+ *                                collected so far are not thrown away;
+ *                            3 = as 2, preceded by release-interface,
+ *                                g_usb_device_reset() and re-claim -- the same
+ *                                sequence fpc_dev_init() runs at every open.
+ *   FPC_X_CAPTURE_TIMEOUT_MS timeout for the enroll arm command only. The
+ *                            device dies ~72 ms after the host cancels the
+ *                            transfer, which no run so far can separate from
+ *                            a ~1.07 s firmware watchdog; raising only this
+ *                            timeout does separate them. Init keeps
+ *                            CTRL_TIMEOUT so a genuinely absent device still
+ *                            fails fast.
+ *   FPC_X_RETRIES / _MS      retry the arm command instead of failing the
+ *                            operation on the first timeout.
+ *   FPC_X_NODUP              do not advertise FP_DEVICE_FEATURE_IDENTIFY, so
+ *                            no identify capture runs ahead of the enroll and
+ *                            the first arm lands in the state the device
+ *                            answers. See fpi_device_fpcmoh_class_init().
+ */
+static gint
+fpc_x_env (const char *name, gint dflt)
+{
+  const char *s = g_getenv (name);
+
+  return (s && *s) ? (gint) g_ascii_strtoll (s, NULL, 10) : dflt;
+}
+
+static void fpc_init_sm_run_state (FpiSsm   *ssm,
+                                   FpDevice *device);
+
+static void
+fpc_reinit_sm_run_state (FpiSsm *ssm, FpDevice *device)
+{
+  switch (fpi_ssm_get_cur_state (ssm))
+    {
+    case FPC_INIT_TLS_CONNECT:
+      /* fpc_connect_tls() calls fpc_tls_buff_init()/fpc_tls_write_buff_init()
+       * unconditionally; release the live ones first so the second init does
+       * not run on top of them. */
+      fpc_tls_write_buff_release ();
+      fpc_tls_buff_release ();
+      break;
+
+    case FPC_INIT_TEE_INIT:
+      /* Deliberately NOT re-running fpc_tee_init()/fpc_tee_bio_init(): the bio
+       * holds this enrollment's accumulated samples (fpc_tee_begin_enroll ran
+       * back in FP_ENROLL_BEGIN, and those calls emit no USB traffic at all --
+       * the accumulator is entirely host-side in libfpcbep.so). Re-creating it
+       * here would silently discard every sample taken so far. */
+      fp_info ("a900-X: re-init finished, keeping tee/bio %p",
+               (void *) FPI_DEVICE_FPCMOH (device)->dev_ctx->bio);
+      fpi_ssm_mark_completed (ssm);
+      return;
+
+    default:
+      break;
+    }
+
+  fpc_init_sm_run_state (ssm, device);
+}
+
+static void
+fpc_x_drain_cb (FpiUsbTransfer *transfer,
+                FpDevice       *device,
+                gpointer        user_data,
+                GError         *error)
+{
+  g_return_if_fail (transfer->ssm);
+
+  if (error)
+    {
+      fp_info ("a900-X: drain read ended (%s) -- nothing was queued",
+               error->message);
+      g_clear_error (&error);
+      fpi_ssm_next_state (transfer->ssm);
+      return;
+    }
+
+  fp_info ("a900-X: drain read returned %" G_GSIZE_FORMAT
+           " bytes -- the device DID have queued data",
+           (gsize) transfer->actual_length);
+  /* Back to whichever of the two drain states issued this read. */
+  fpi_ssm_jump_to_state (transfer->ssm, fpi_ssm_get_cur_state (transfer->ssm));
+}
+
+static void
+fpc_enroll_capture_cb (FpiUsbTransfer *transfer,
+                       FpDevice       *device,
+                       gpointer        user_data,
+                       GError         *error)
+{
+  FpiDeviceFpcMoh *self = FPI_DEVICE_FPCMOH (device);
+  gint retries = fpc_x_env ("FPC_X_RETRIES", 0);
+
+  g_return_if_fail (transfer->ssm);
+
+  if (error)
+    {
+      if ((gint) self->x_retry_count < retries)
+        {
+          gint ms = fpc_x_env ("FPC_X_RETRY_MS", 500);
+
+          self->x_retry_count++;
+          fp_info ("a900-X: arm attempt %u failed (%s), retrying in %d ms",
+                   self->x_retry_count, error->message, ms);
+          g_clear_error (&error);
+          fpi_ssm_jump_to_state_delayed (transfer->ssm, FP_ENROLL_CAPTURE, ms);
+          return;
+        }
+
+      fpi_ssm_mark_failed (transfer->ssm, error);
+      return;
+    }
+
+  if (self->x_retry_count)
+    fp_info ("a900-X: arm succeeded on attempt %u", self->x_retry_count + 1);
+
+  fpi_ssm_next_state (transfer->ssm);
+}
